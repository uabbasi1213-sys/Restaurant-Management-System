{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "Restaurant Management System Desktop App",
  "author": "Restaurant Admin",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "cd server && npm start",
    "electron:dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"wait-on http://localhost:5173 && electron .\"",
    "build:client": "cd client && npm run build",
    "build:client:electron": "cd client && npx vite build --mode electron",
    "electron:build": "npm run build:client:electron && electron-builder",
    "electron:start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.restaurant.management",
    "productName": "Restaurant Management System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraFiles": [
      {
        "from": "server/server.bundle.mjs",
        "to": "resources/server.bundle.mjs"
      },
      {
        "from": "server/sql-wasm.wasm",
        "to": "resources/sql-wasm.wasm"
      },
      {
        "from": "client/dist",
        "to": "resources/client-dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
